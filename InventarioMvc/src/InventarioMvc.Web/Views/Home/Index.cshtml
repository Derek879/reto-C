@model InicioViewModel
@{ ViewData["Title"] = "Inicio"; }

<h1 class="h3 mb-4">Resumen</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small">Ventas de hoy</div>
        <div class="fs-3 fw-semibold">@Model.VentasHoy.ToString("C")</div>
    </div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small">Ventas del mes</div>
        <div class="fs-3 fw-semibold">@Model.VentasMes.ToString("C")</div>
    </div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small">N° de ventas del mes</div>
        <div class="fs-3 fw-semibold">@Model.CantidadVentasMes</div>
    </div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h5">Productos por reponer</h2>
        @if (Model.StockBajo.Count == 0)
        {
            <p class="text-muted">Todo el stock está sobre el mínimo.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Producto</th><th class="text-end">Stock</th><th class="text-end">Mínimo</th></tr></thead>
                <tbody>
                @foreach (var p in Model.StockBajo)
                {
                    <tr class="table-warning"><td>@p.Nombre</td><td class="text-end">@p.Stock</td><td class="text-end">@p.StockMinimo</td></tr>
                }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h5">Más vendidos del mes</h2>
        <table class="table table-sm">
            <thead><tr><th>Producto</th><th class="text-end">Unidades</th><th class="text-end">Total</th></tr></thead>
            <tbody>
            @foreach (var t in Model.TopMes)
            {
                <tr><td>@t.Nombre</td><td class="text-end">@t.Unidades</td><td class="text-end">@t.Total.ToString("C")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
